# ---------------------------------------------------------------------------
# Environment template.
#
# Copy to `.env.local` for local development, and set the same keys in your
# host's environment settings for deployments. `.env.local` is gitignored;
# this file contains no secrets and is safe to commit.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# MongoDB connection string. Include the database name in the path, or set
# MONGODB_DB separately.
MONGODB_URI=""
MONGODB_DB="techseum"

# ---------------------------------------------------------------------------
# Sessions
# ---------------------------------------------------------------------------
# Signs session tokens. Must be a long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=""

# Local production testing only. `next start` reports NODE_ENV=production, which
# marks the session cookie Secure and therefore unusable over http://localhost.
# Set "true" ONLY when running `next start` locally. Never set this where the
# site is actually deployed.
AUTH_COOKIE_INSECURE=""

# ---------------------------------------------------------------------------
# AI assistant
# ---------------------------------------------------------------------------
# Server-side API key. Only read inside route handlers, never sent to the
# browser.
AI_API_KEY=""

# Model identifier for the assistant.
AI_MODEL="gemini-2.5-flash"

# ---------------------------------------------------------------------------
# Newsletter (Resend)
# ---------------------------------------------------------------------------
# Server-side API key for sending the welcome email and weekly digest.
RESEND_API_KEY=""

# The From address on newsletter emails. Until you verify a domain in Resend,
# only `onboarding@resend.dev` works, and Resend will only deliver to the email
# address that owns the account. Verify a domain to send to real subscribers.
NEWSLETTER_FROM="Techseum <onboarding@resend.dev>"

# Optional. A Resend audience ID for syncing contacts. Leave empty to keep the
# subscriber list in MongoDB only. Note that a Resend key scoped to
# "send emails only" cannot manage audiences, so this is skipped automatically
# for such keys.
NEWSLETTER_AUDIENCE_ID=""

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# Public base URL for metadata and canonical links.
NEXT_PUBLIC_SITE_URL="https://techseum.rakasyau.my.id"
